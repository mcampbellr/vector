# OS
.DS_Store

# Go
/bin/
cli/bin/
/dist/
*.test
*.out

# Web (board panel)
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo
# Built web assets embedded into the binary. The real, hashed index.html is a
# product of `web build`, so it is gitignored alongside assets/; the committed
# dist/index.placeholder.html — which carries no /assets/* refs — is what keeps a
# clean checkout's embed valid and the build-time integrity guard decidable.
cli/internal/webui/dist/assets/
cli/internal/webui/dist/index.html

# Local
*.local
.env

# Vector state: config + per-spec state.json are committed; the local activity
# log is not (per docs/schemas/state-and-activity.md).
.vector/local/
# Transient scratch (e.g. spec docs composed by /vector:raw before registration).
.vector/tmp/
# Derived repo-intel cache (class C): regenerable, fingerprint-validated, never
# committed (docs/knowledge-architecture.md §3).
.vector/cache/

# Obsidian (volatile UI state — keep app.json/core-plugins.json/graph.json)
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/workspace.json.bak
docs/.obsidian/cache

# Kit assets seeded by `vector update` — edit in kit/, not here.
.claude/agents/
.claude/commands/vector/
